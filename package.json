{
	"name": "@fast-china/eslint-config",
	"version": "2.1.10",
	"description": "Practical, typed ESLint Flat Config for Vue 3, UniApp, React, Angular, Vite, TypeScript, JavaScript, and Node.js.",
	"type": "module",
	"keywords": [
		"fast",
		"fast-china",
		"angular",
		"eslint",
		"eslint-config",
		"flat-config",
		"react",
		"typescript",
		"uniapp",
		"vite",
		"vue",
		"vue3"
	],
	"license": "Apache-2.0",
	"homepage": "http://fastdotnet.com",
	"bugs": {
		"url": "https://gitee.com/FastDotnet/fast.eslint.config/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://gitee.com/FastDotnet/fast.eslint.config"
	},
	"author": "小方",
	"files": [
		"CHANGELOG.md",
		"CONTRIBUTING.md",
		"Fast.png",
		"LICENSE",
		"README.md",
		"README.zh.md",
		"SECURITY.md",
		"dist"
	],
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./configs": {
			"types": "./dist/configs/index.d.mts",
			"import": "./dist/configs/index.mjs",
			"default": "./dist/configs/index.mjs"
		},
		"./constants": {
			"types": "./dist/constants/index.d.mts",
			"import": "./dist/constants/index.mjs",
			"default": "./dist/constants/index.mjs"
		},
		"./rules": {
			"types": "./dist/rules/index.d.mts",
			"import": "./dist/rules/index.mjs",
			"default": "./dist/rules/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "eslint-config-inspector --config src/eslint-inspector.config.ts",
		"build": "pnpm run typegen:check && tsdown",
		"build:inspector": "eslint-config-inspector build --config src/eslint-inspector.config.ts",
		"docs:rules": "tsx scripts/rules-docs.ts",
		"docs:rules:check": "tsx scripts/rules-docs.ts --check",
		"typegen": "tsx scripts/typegen.ts",
		"typegen:check": "tsx scripts/typegen.ts --check",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "pnpm run build && pnpm run test:types && pnpm run test:runtime && pnpm run test:package",
		"test:types": "tsc --noEmit --project tests/tsconfig.json",
		"test:runtime": "node --test tests/config.test.mjs tests/tool-ignores.test.mjs",
		"test:package": "node --test tests/package.test.mjs",
		"check": "pnpm run typecheck && pnpm run docs:rules:check && pnpm run test && pnpm run lint && pnpm run format:check",
		"prepack": "pnpm run check"
	},
	"peerDependencies": {
		"eslint": "^10.0.0",
		"typescript": "^6.0.0"
	},
	"dependencies": {
		"@angular-eslint/eslint-plugin": "^22.5.0",
		"@angular-eslint/eslint-plugin-template": "^22.5.0",
		"@angular-eslint/template-parser": "^22.5.0",
		"@eslint-react/eslint-plugin": "^5.19.0",
		"@eslint/js": "^10.0.1",
		"@eslint/markdown": "^8.0.3",
		"eslint-config-flat-gitignore": "^2.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-regexp": "^3.3.0",
		"eslint-plugin-vue": "^10.11.0",
		"globals": "^17.12.0",
		"typescript-eslint": "^8.70.0",
		"vue-eslint-parser": "^10.4.1"
	},
	"devDependencies": {
		"@eslint/config-inspector": "^3.4.1",
		"@types/node": "^24.13.4",
		"eslint": "^10.10.0",
		"eslint-typegen": "^2.3.1",
		"prettier": "^3.9.6",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": "^22.18.0 || ^24.18.0",
		"pnpm": "^11.0.0"
	}
}
